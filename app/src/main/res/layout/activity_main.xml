<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- Profile Button (Top Left) -->
    <ImageButton
        android:id="@+id/btnProfileFloat"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_margin="16dp"
        android:background="@drawable/circle_button"
        android:src="@android:drawable/ic_menu_myplaces"
        android:scaleType="centerInside"
        android:padding="12dp"
        android:elevation="6dp"
        android:contentDescription="Profile" />

    <!-- Floating Music Button (Top Right) -->
    <ImageButton
        android:id="@+id/btnMusicFloat"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        android:background="@drawable/circle_button"
        android:src="@android:drawable/ic_lock_silent_mode_off"
        android:scaleType="centerInside"
        android:padding="12dp"
        android:elevation="6dp"
        android:contentDescription="Music Settings" />

    <!-- Statistics Icon Button (Top Right, below music) -->
    <ImageButton
        android:id="@+id/btnStatsIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_below="@id/btnMusicFloat"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/circle_button"
        android:src="@android:drawable/ic_menu_info_details"
        android:scaleType="centerInside"
        android:padding="12dp"
        android:elevation="6dp"
        android:contentDescription="Statistics" />

    <!-- Main Content Container -->
    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Slidr"
            android:textSize="42sp"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:id="@+id/tvTotalStars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐ 0 Stars"
            android:textSize="24sp"
            android:textColor="#FFD700"
            android:textStyle="bold"
            android:layout_marginBottom="40dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Mode"
            android:textSize="20sp"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.7"
            android:layout_marginBottom="30dp"/>

        <Button
            android:id="@+id/btnClassic"
            android:layout_width="280dp"
            android:layout_height="70dp"
            android:text="🎮 Classic Mode"
            android:textSize="18sp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#4CAF50"/>

        <Button
            android:id="@+id/btnStoryMode"
            android:layout_width="280dp"
            android:layout_height="70dp"
            android:text="📖 Story Mode"
            android:textSize="18sp"
            android:backgroundTint="#2196F3"/>

    </LinearLayout>

    <!-- Story Mode Selection Frame (Hidden by default) -->
    <FrameLayout
        android:id="@+id/storyModeFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone"
        android:clickable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:paddingTop="32dp"
            android:paddingBottom="32dp"
            android:background="?attr/colorSurface"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="32dp"
            android:elevation="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Story"
                android:textSize="28sp"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                android:layout_marginBottom="30dp"/>

            <!-- Removed individual margins from buttons -->
            <Button
                android:id="@+id/btnOnePiece"
                android:layout_width="280dp"
                android:layout_height="65dp"
                android:text="🏴‍☠️ One Piece"
                android:textSize="18sp"
                android:layout_marginBottom="15dp"
                android:backgroundTint="#FF6B35"/>

            <Button
                android:id="@+id/btnDragonBall"
                android:layout_width="280dp"
                android:layout_height="65dp"
                android:text="🐉 Dragon Ball Z"
                android:textSize="18sp"
                android:layout_marginBottom="15dp"
                android:backgroundTint="#FFA500"/>

            <Button
                android:id="@+id/btnBleach"
                android:layout_width="280dp"
                android:layout_height="65dp"
                android:text="⚔️ Bleach"
                android:textSize="18sp"
                android:layout_marginBottom="25dp"
                android:backgroundTint="#4169E1"/>

            <Button
                android:id="@+id/btnBackFromStory"
                android:layout_width="280dp"
                android:layout_height="60dp"
                android:text="← Back"
                android:textSize="16sp"
                android:backgroundTint="#9E9E9E"/>

        </LinearLayout>

    </FrameLayout>

</RelativeLayout>